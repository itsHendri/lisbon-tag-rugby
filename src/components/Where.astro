---
import type { Lang, Content } from "../i18n/types";

interface Props {
  lang: Lang;
  t: Content;
}
const { lang, t } = Astro.props;
---

<section class="section" id="where" data-contrast="light">
  <div class="container where-grid">
    <div>
      <p class="kicker reveal">{t.where.kicker}</p>
      <h2 class="section-title reveal" style="--d: 0.06s">{t.where.title}</h2>
      <div class="reveal" style="--d: 0.12s">
        <div class="when display">{t.where.when}</div>
        <p class="venue"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 21s-6.5-5.4-6.5-10.3a6.5 6.5 0 0 1 13 0C18.5 15.6 12 21 12 21z" /><circle cx="12" cy="10.5" r="2.3" /></svg> {t.where.venue}</p>
      </div>
      <p class="lead reveal" style="--d: 0.18s">{t.where.body}</p>
      <p class="lead reveal" style="--d: 0.24s; font-size: 14px; color: var(--ink-soft)">
        {t.where.rain}
      </p>
      <div class="btn-row reveal" style="--d: 0.3s">
        <a class="btn btn-ink" href={t.where.mapLink} target="_blank" rel="noopener">
          {t.where.directions} <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </div>
    <div class="map-frame reveal" style="--d: 0.16s">
      <iframe
        title="Lisbon Tag Rugby on Google Maps"
        src={t.where.mapEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>
