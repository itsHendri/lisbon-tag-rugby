---
import type { Lang, Content } from "../i18n/types";

interface Props {
  lang: Lang;
  t: Content;
}
const { lang, t } = Astro.props;
---

<section class="section" id="join" data-contrast="light">
  <div class="container">
    <p class="kicker reveal">{t.join.kicker}</p>
    <h2 class="section-title reveal">{t.join.title}</h2>

    <div class="steps">
      {
        t.join.steps.map((s, i) => (
          <div class="step reveal" style={`--d: ${0.1 * i}s`}>
            <span class="n">{String(i + 1).padStart(2, "0")}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))
      }
    </div>

    <div class="btn-row reveal">
      <a
        class="btn btn-ink"
        href={t.join.whatsappHref}
        title={t.join.whatsappTbd ? "Number coming soon" : undefined}
        aria-label={t.join.whatsappLabel}
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3.8a8.2 8.2 0 0 0-7 12.4L4 20l3.9-1a8.2 8.2 0 1 0 4.1-15.2z" /><path d="M9.2 8.9c.3-.7 1.2-.8 1.5-.2l.5 1.1c.1.3 0 .7-.2.9l-.4.4c.5 1 1.3 1.8 2.3 2.3l.4-.4c.2-.2.6-.3.9-.2l1.1.5c.6.3.5 1.2-.2 1.5-.6.3-1.3.4-1.9.2a7 7 0 0 1-3.3-3.3c-.2-.6-.1-1.3.3-1.8z" fill="currentColor" stroke="none" /></svg> {t.join.whatsappLabel}
      </a>
      <a class="btn btn-terra" href={t.join.instagramHref} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" /></svg> {t.join.instagramLabel} @lisbontagrugby
      </a>
    </div>

    <p class="lead reveal" style="margin-top: 24px">{t.join.invite}</p>
  </div>
</section>
