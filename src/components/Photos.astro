---
import type { Lang, Content } from "../i18n/types";

interface Props {
  lang: Lang;
  t: Content;
}
const { lang, t } = Astro.props;
---

<section class="section" id="wall" data-contrast="alt">
  <div class="container">
    <p class="kicker reveal">{t.photos.kicker}</p>
    <h2 class="section-title reveal">{t.photos.title}</h2>
    <div class="wall">
      {
        t.photos.items.map((p, i) => (
          <figure
            class:list={["photo-card", p.tall && "tall"], "reveal"}
            style={`--d: ${0.07 * (i % 3)}s`}
          >
            <img src={p.src} alt={p.alt} loading="lazy" width="1280" />
            {p.caption && <figcaption class="tag">{p.caption}</figcaption>}
          </figure>
        ))
      }
    </div>
  </div>
</section>
