---
import type { Content } from "../i18n/types";

interface Props {
  t: Content;
}
const { t } = Astro.props;

// The full-video popup. No real footage yet, so it shows a still with a
// clear placeholder mark. When the club video exists (public/media/hero-loop.mp4),
// swap the <img> below for: <video class="media" id="popup-video" controls autoplay muted loop playsinline src="/media/hero-loop.mp4"></video>
---

<dialog
  id="video-popup"
  class="video-popup"
  aria-label={t.popup.title}
>
  <header>
    <span class="t display">{t.popup.title}</span>
    <button class="popup-close" data-popup-close aria-label={t.popup.close}>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" /></svg>
    </button>
  </header>
  <div class="stage">
    <img class="media" src="/media/tag-event.jpg" alt="" />
    <div class="placeholder-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="56" height="56" fill="rgba(241,236,223,0.9)" role="img" aria-label="Play">
        <path d="M8 5.5v13l11-6.5-11-6.5z" />
      </svg>
    </div>
  </div>
  <p class="note">{t.popup.note}</p>
</dialog>
